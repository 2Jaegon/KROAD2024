<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plotting_pkg</name>
  <version>0.0.0</version>
  <description>A package to plot paths and trajectories</description>
  <maintainer email="ulix7990@gmail.com">ulix7990</maintainer>
  <license>MIT</license>  <!-- TODO: License declaration을 실제 라이선스로 교체 -->

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>matplotlib</depend>
  <depend>numpy</depend>
  <depend>pandas</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
